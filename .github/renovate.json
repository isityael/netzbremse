{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>isityael/infra//.github/renovate/base.json",
    "config:best-practices",
    ":preserveSemverRanges"
  ],
  "enabledManagers": [
    "gomod",
    "npm",
    "dockerfile",
    "github-actions",
    "woodpecker"
  ],
  "semanticCommits": "enabled",
  "lockFileMaintenance": {
    "enabled": false
  },
  "packageRules": [
    {
      "matchManagers": [
        "gomod"
      ],
      "addLabels": [
        "go"
      ],
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "addLabels": [
        "npm"
      ],
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "addLabels": [
        "docker"
      ],
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": [
        "woodpecker"
      ],
      "addLabels": [
        "docker"
      ],
      "semanticCommitType": "ci",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "addLabels": [
        "ci"
      ]
    },
    {
      "description": "Auto-merge patch and minor Go module updates \u2014 CI-verified",
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true
    },
    {
      "description": "Auto-merge GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "automerge": true
    },
    {
      "description": "Use container version tags only.",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": false
    },
    {
      "description": "Do not create container digest pins or digest refreshes.",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "enabled": false
    },
    {
      "description": "One reviewed weekly dependency refresh, including majors, charts, images and tooling.",
      "matchPackageNames": [
        "*"
      ],
      "groupName": "weekly dependencies",
      "groupSlug": "weekly-dependencies",
      "groupSingleUpdates": true,
      "minimumGroupSize": 1,
      "additionalBranchPrefix": "",
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "separateMultipleMajor": false,
      "separateMultipleMinor": false,
      "schedule": [
        "* 0-5 * * 1"
      ],
      "automerge": false
    }
  ],
  "pinDigests": false,
  "ignorePresets": [
    "docker:pinDigests"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "* 0-5 * * 1"
  ],
  "separateMajorMinor": false,
  "separateMinorPatch": false,
  "separateMultipleMajor": false,
  "separateMultipleMinor": false,
  "prConcurrentLimit": 1,
  "automerge": false
}
